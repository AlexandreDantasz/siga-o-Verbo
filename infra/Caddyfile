# ==============================================================================
# Caddyfile - Siga o Verbo
# O Caddy obtém e renova o certificado SSL (Let's Encrypt / ZeroSSL) automaticamente.
# Sem necessidade de Certbot ou cron jobs manuais.
# ==============================================================================

# Substitua 'seu-dominio.com.br' pelo domínio real quando registrá-lo
seu-dominio.com.br {
    # Pasta raiz onde os arquivos estáticos compilados pelo CI/CD residem
    root * /var/www/siga-o-verbo

    # Habilita compressão ultrarrápida (Zstandard e Gzip)
    encode zstd gzip

    # Serve os arquivos estáticos com cache inteligente
    file_server

    # Redirecionamento 404 personalizado respeitando a página 404 do Hugo
    handle_errors {
        rewrite * /404.html
        file_server
    }

    # Cabeçalhos de segurança modernos (Apple/OWASP recommendations)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Cache de longa duração para assets estáticos imutáveis
    @static {
        path /css/* /js/* /images/* *.svg *.png *.jpg *.jpeg *.webp *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
